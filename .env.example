# Copy to .env and adjust. Shared by Docker Compose and Rails (dotenv-rails).

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=postgres
# Host port mapped to Postgres 5432 inside the Compose network.
POSTGRES_HOST_PORT=5433

# --- App ------------------------------------------------------------------
APP_PORT=3001
RAILS_MAX_THREADS=5
BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3100
MAILER_SENDER=no-reply@hrzen.test

# --- Local (non-Docker) Rails --------------------------------------------
# Used when running bin/rails on the host against the Compose-mapped Postgres.
# Compose overrides this to postgres://...@db:5432 inside the containers.
DB_URL=postgres://root:root@127.0.0.1:5433

# Frontend (Next.js) — for reference
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Platform superadmin seed (bin/rails db:seed)
SUPERADMIN_EMAIL=superadmin@hrzen.test
SUPERADMIN_PASSWORD=password123
PLATFORM_ORG_NAME=HR Zen
PLATFORM_ORG_SUBDOMAIN=hr-zen

# Assistant (RubyLLM)
OPENAI_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
